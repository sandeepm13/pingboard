{
  "name": "pingboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --tsconfig worker/tsconfig.json --env-file-if-exists=.env worker/src/index.ts",
    "dev:all": "concurrently --kill-others-on-fail -n web,worker -c cyan,magenta \"npm:dev\" \"npm:dev:worker\"",
    "build": "next build",
    "build:worker": "esbuild worker/src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --tsconfig=worker/tsconfig.json --sourcemap --outfile=worker/dist/index.mjs",
    "build:all": "npm run build && npm run build:worker",
    "start": "next start",
    "start:worker": "node --enable-source-maps --env-file-if-exists=.env worker/dist/index.mjs",
    "start:all": "concurrently --kill-others-on-fail -n web,worker -c cyan,magenta \"npm:start\" \"npm:start:worker\"",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit && tsc -p worker/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "services:up": "docker compose up -d --wait",
    "services:down": "docker compose down",
    "services:logs": "docker compose logs -f",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "tsx scripts/e2e.ts",
    "load-test": "tsx --tsconfig worker/tsconfig.json scripts/load-test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "bcryptjs": "3.0.3",
    "bullmq": "6.4.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "ioredis": "6.0.0",
    "lucide-react": "1.61.0",
    "mongoose": "9.11.4",
    "motion": "14.6.0",
    "next": "16.4.3",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "nodemailer": "10.2.1",
    "pino": "10.4.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "shadcn": "4.22.1",
    "sonner": "2.0.8",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.6",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "nodemailer": "$nodemailer"
  }
}

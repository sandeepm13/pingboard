# ============================================================
# PingBoard environment variables
# Copy to .env (never commit .env). Fill in every value.
# ============================================================

# ---------- General ----------
# development | production | test
NODE_ENV=
# Public base URL of the web app (used in emails, alert links, OAuth callbacks).
# The worker reads it too, for the "View incident" links in alerts. Static
# pages bake it in at build time (canonical URLs, sitemap), so build with the
# real value.
APP_URL=
# trace | debug | info | warn | error | fatal (worker default: debug in development, info otherwise)
LOG_LEVEL=

# ---------- MongoDB ----------
# Connection string used by BOTH the web app and the worker.
# MongoDB Atlas form: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/   (add your IP in Atlas > Network Access)
# Local docker-compose form: mongodb://<user>:<password>@127.0.0.1:<MONGO_HOST_PORT>/pingboard?authSource=admin
MONGODB_URI=
# Database name (used by app + worker; overrides the db in the URI). e.g. pingboard
MONGODB_DB=
# docker-compose only: root user/password for the mongo container
MONGO_INITDB_ROOT_USERNAME=
MONGO_INITDB_ROOT_PASSWORD=
# docker-compose only: host port for local MongoDB (default 27018, avoids clashing with a locally installed MongoDB on 27017)
MONGO_HOST_PORT=

# ---------- Redis (BullMQ queue + rate limiting) ----------
# Connection string used by BOTH the web app and the worker.
# Local Redis/Memurai without a password: redis://127.0.0.1:6379
# Hosted (e.g. Redis Cloud): redis://default:<password>@<host>:<port>   (rediss:// for TLS)
# Local docker-compose form: redis://:<REDIS_PASSWORD>@127.0.0.1:<REDIS_HOST_PORT>
REDIS_URL=
# docker-compose only: password for the redis container
REDIS_PASSWORD=
# docker-compose only: host port for local Redis (default 6379)
REDIS_HOST_PORT=

# ---------- Auth.js (next-auth v5) ----------
# REQUIRED. Random secret (min 32 chars) that signs + encrypts the session cookie.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it logs everyone out.
AUTH_SECRET=
# Public URL of the app, used to build OAuth callback URLs. Dev: http://localhost:3000
AUTH_URL=
# Set to true in production behind a reverse proxy (nginx/Caddy/Docker). Not needed in dev.
AUTH_TRUST_HOST=
# OPTIONAL. Google sign-in (Google Cloud Console > APIs & Services > Credentials > OAuth client ID).
# Authorized redirect URI: <AUTH_URL>/api/auth/callback/google
# Leave empty to hide the "Continue with Google" button.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# OPTIONAL. GitHub sign-in (GitHub > Settings > Developer settings > OAuth Apps).
# Authorization callback URL: <AUTH_URL>/api/auth/callback/github
# Leave empty to hide the "Continue with GitHub" button.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# ---------- Encryption at rest ----------
# 32-byte key (base64) used to encrypt monitor headers/body, webhook URLs and bot tokens
# in the database (generate: openssl rand -base64 32). Rotating it requires re-encrypting data.
ENCRYPTION_KEY=

# ---------- Email (alert emails + password reset) ----------
# Read by BOTH the web app and the worker. Which provider to use:
#   console (default) = print emails to the server log (development only; in
#                       production every email fails with "Email isn't set up")
#   resend            = Resend REST API (https://resend.com, needs RESEND_API_KEY)
#   smtp              = any SMTP server via Nodemailer (e.g. Gmail with an app password)
EMAIL_PROVIDER=
# "From" address, e.g. PingBoard <alerts@yourdomain.com>.
# Blank: resend → PingBoard <onboarding@resend.dev> (Resend's test sender, only
# delivers to your own Resend account email); smtp → SMTP_USER.
EMAIL_FROM=
# Resend API key (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# SMTP settings (when EMAIL_PROVIDER=smtp). Gmail: smtp.gmail.com, 465, your
# address, and an App Password (Google Account > Security > App passwords).
SMTP_HOST=
# Default 587 (STARTTLS); 465 = implicit TLS
SMTP_PORT=
# Blank = true for port 465, false otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ---------- Alerts (worker) ----------
# Alert deliveries the worker sends in parallel (default 5). Discord/Slack
# webhook URLs and Telegram bot tokens are added per user under /app/alerts
# (stored encrypted with ENCRYPTION_KEY); nothing to configure here.
ALERT_CONCURRENCY=

# ---------- Worker / checker ----------
# Blank = default. Check limits (timeouts, body cap, redirects, the
# 2-failures rule, retention) are constants in src/lib/shared/constants.ts.
# How many checks the worker runs in parallel (default 50; watch the worker's
# "schedule lag" log line when tuning)
WORKER_CONCURRENCY=
# GET /health on this port (default 3001) and host (default 127.0.0.1; use 0.0.0.0 in a container)
WORKER_HEALTH_PORT=
WORKER_HEALTH_HOST=
# User-Agent header sent with every check, so site owners can identify us
CHECK_USER_AGENT=
# Response time above this (ms) marks an up check as "degraded" (amber). Default 2000
SLOW_THRESHOLD_MS=

# ---------- Security ----------
# DEV ONLY: allow monitors to hit private/internal addresses (SSRF guard off).
# Must be false in production; the app refuses to start otherwise.
SSRF_ALLOW_PRIVATE=
# Rate limits are per-rule constants in src/lib/rate-limit.ts (stored in Redis via REDIS_URL).
